# Copia este archivo como .env.local y completa los valores (nunca los pegues en el chat).
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Solo servidor: clave secreta (service role). Se usa para cargar datos y para la búsqueda en Places.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Solo para correr las migraciones desde tu computadora: Project Settings → Database → Connection string (URI, "Session pooler")
SUPABASE_DB_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-0-xx.pooler.supabase.com:5432/postgres
# Google Places (la misma de sistema/.env)
PLACES_API_KEY=
# Clave para cifrar el token de Google guardado en la base (32 bytes en base64). Generar una por entorno.
TOKEN_CIFRADO_CLAVE=
# Secreto que n8n manda para ejecutar las tareas programadas (Authorization: Bearer …)
TAREAS_SECRETO=
# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Correo de avisos por Zoho (SMTP). Zoho → Mi cuenta → Seguridad → Contraseñas específicas de la aplicación.
SMTP_USER=
SMTP_PASS=
# Opcionales: el host exacto está en Zoho Mail → Configuración → Cuentas de correo (smtp.zoho.com o smtppro.zoho.com)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
# Solo si el usuario SMTP no es un correo (Resend: SMTP_USER=resend, SMTP_HOST=smtp.resend.com)
SMTP_FROM=
